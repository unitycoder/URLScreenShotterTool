<Window x:Class="UrlScreenshotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URL Screenshotter" Width="1080" Height="830" MinWidth="880" MinHeight="700"
        Background="{StaticResource BackgroundBrush}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="154" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,17">
            <TextBlock Text="URL Screenshotter" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Capture a list of websites at exact viewport sizes using Microsoft Edge or Chrome."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,7">
                        <TextBlock Text="URLs" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Load .txt" Click="LoadUrls_Click" Margin="0,0,7,0" />
                            <Button Content="Save list" Click="SaveUrls_Click" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="One HTTP or HTTPS address per line" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9" />
                    <TextBox x:Name="UrlsText" Grid.Row="2" FontFamily="Consolas" FontSize="13" AcceptsReturn="True"
                             AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" />
                    <TextBlock Grid.Row="3" Margin="0,11,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Tip: Use Interactive capture to log in, dismiss dialogs or position a 3D/WebGL scene before saving." />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Capture settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <TextBlock Text="Resolution preset" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged" SelectedIndex="0" Margin="0,0,0,11">
                            <ComboBoxItem><TextBlock Foreground="Black" Text="Custom" /></ComboBoxItem>
                            <ComboBoxItem Tag="1920,1080"><TextBlock Foreground="Black" Text="1920 x 1080 (16:9)" /></ComboBoxItem>
                            <ComboBoxItem Tag="1280,720"><TextBlock Foreground="Black" Text="1280 x 720 (16:9)" /></ComboBoxItem>
                            <ComboBoxItem Tag="1600,1200"><TextBlock Foreground="Black" Text="1600 x 1200 (4:3)" /></ComboBoxItem>
                            <ComboBoxItem Tag="1080,1080"><TextBlock Foreground="Black" Text="1080 x 1080 (1:1)" /></ComboBoxItem>
                            <ComboBoxItem Tag="1080,1920"><TextBlock Foreground="Black" Text="1080 x 1920 (9:16)" /></ComboBoxItem>
                        </ComboBox>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Width (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="WidthText" Text="1280" TextChanged="SizeText_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="HeightText" Text="720" TextChanged="SizeText_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Wait after load (sec)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="DelayText" Text="3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Navigation timeout (sec)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="TimeoutText" Text="30" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Browser" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="BrowserCombo" SelectedIndex="0" Margin="0,0,0,7">
                            <ComboBoxItem><TextBlock Foreground="Black" Text="Microsoft Edge (installed)" /></ComboBoxItem>
                            <ComboBoxItem><TextBlock Foreground="Black" Text="Google Chrome (installed)" /></ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="FullPageCheck" Content="Capture full scrollable page" />
                        <CheckBox x:Name="InteractiveCheck" Content="Interactive: click Capture for each URL" />
                        <TextBlock Text="Save screenshots to" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,5" />
                        <DockPanel LastChildFill="True">
                            <Button Content="Explore" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ExploreOutput_Click" />
                            <Button Content="Browse" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" />
                            <TextBox x:Name="OutputText" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Last screenshot" FontWeight="SemiBold" Margin="0,17,0,7" />
                        <Border Height="160" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource FieldBrush}">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="5" />
                                <TextBlock x:Name="PreviewPlaceholder" Text="Preview will appear here" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,11">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start capture" Click="Start_Click" Background="#166C9C" BorderBrush="#238AC2" FontWeight="SemiBold" />
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Margin="8,0,0,0" IsEnabled="False" />
                    <Button x:Name="CaptureButton" Content="Capture this page" Click="Capture_Click" Margin="18,0,0,0" IsEnabled="False" />
                    <Button x:Name="SkipButton" Content="Skip page" Click="Skip_Click" Margin="8,0,0,0" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ProgressBar x:Name="CaptureProgress" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Activity log" FontSize="14" FontWeight="SemiBold" Margin="3,0,0,8" />
                <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource MutedBrush}"
                         FontSize="12" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
